{
  "name": "zerobox",
  "version": "0.1.6",
  "description": "Run any command in a sandbox with file and network restrictions.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/afshinm/zerobox"
  },
  "homepage": "https://github.com/afshinm/zerobox",
  "keywords": [
    "sandbox",
    "security",
    "isolation",
    "seatbelt",
    "bubblewrap",
    "seccomp"
  ],
  "type": "module",
  "bin": {
    "zerobox": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/"
  },
  "optionalDependencies": {
    "@zerobox/cli-darwin-arm64": "workspace:*",
    "@zerobox/cli-darwin-x64": "workspace:*",
    "@zerobox/cli-linux-arm64": "workspace:*",
    "@zerobox/cli-linux-x64": "workspace:*",
    "@zerobox/cli-linux-arm64-musl": "workspace:*",
    "@zerobox/cli-linux-x64-musl": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "provenance": true
  }
}
