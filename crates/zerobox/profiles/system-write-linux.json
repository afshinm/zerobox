{
  "$schema": "./schema.json",
  "description": "Linux temp and device write paths.",
  "platform": "linux",
  "allow_write": [
    "/tmp",
    "$TMPDIR",
    "/dev/null",
    "/dev/zero",
    "/dev/full",
    "/dev/tty",
    "/dev/stdout",
    "/dev/stderr",
    "/dev/fd",
    "/dev/pts",
    "/proc/self/fd"
  ]
}
