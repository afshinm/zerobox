{
  "$schema": "./schema.json",
  "description": "Deny sensitive paths, allow system read/write and common tools.",
  "use": [
    "default",
    "deny-credentials",
    "deny-shell-history",
    "deny-shell-configs",
    "deny-keychains-macos",
    "deny-keychains-linux",
    "deny-browser-data-macos",
