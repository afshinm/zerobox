{
  "name": "zerobox-root",
  "private": true,
  "scripts": {
    "build": "pnpm --filter zerobox run build",
    "test": "pnpm --filter zerobox run test",
    "typecheck": "pnpm --filter zerobox run typecheck",
    "changeset": "changeset",
    "version": "changeset version && ./scripts/sync-version.sh",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0"
  }
}
